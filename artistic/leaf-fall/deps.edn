{:paths ["src" "driver" "repl"]

 :deps
 {org.clojure/clojure {:mvn/version "1.12.4"}
  com.googlecode.lanterna/lanterna {:mvn/version "3.1.5"}
  net.java.dev.jna/jna-platform {:mvn/version "5.19.1"}
  quil/quil           {:mvn/version "4.3.1563"}}

 :aliases
 {:run
  {:main-opts ["-m" "driver"]}

  :terminal
  {:jvm-opts ["--enable-native-access=ALL-UNNAMED"]
   :main-opts ["-m" "leaf-fall.render.lanterna"]}

  :gui
  {:jvm-opts ["--enable-native-access=ALL-UNNAMED"]
   :main-opts ["-m" "gui"]}

  :dev
  {:extra-paths ["test"]
   :jvm-opts ["--enable-native-access=ALL-UNNAMED"]
   :extra-deps
   {nrepl/nrepl       {:mvn/version "1.4.0"}
    cider/cider-nrepl {:mvn/version "0.58.0"}}
   :main-opts
   ["-m" "nrepl.cmdline"
    "--middleware" "[cider.nrepl/cider-middleware]"
    "--interactive"]}

  :test
  {:extra-paths ["test"]
   :main-opts ["-m" "test-runner"]}

  :build
  {:deps
   {io.github.clojure/tools.build {:mvn/version "0.10.11"}}
   :paths ["build"]
   :ns-default build}}}
